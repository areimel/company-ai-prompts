---
import Layout from '@layouts/Layout.astro';
import Container from '@components/container.astro';
import Sectionhead from '@components/sectionhead.astro';
import LoginForm from '@components/AuthComponents/LoginForm.astro';
import { FeatureFlags } from '@lib/feature-flags';

// Redirect if auth is disabled
if (!FeatureFlags.AUTH_ENABLED) {
  return Astro.redirect('/404');
}

// Redirect if already authenticated
const { isAuthenticated } = Astro.locals;
if (isAuthenticated) {
  const redirectTo = Astro.url.searchParams.get('redirect') || '/';
  return Astro.redirect(redirectTo);
}

const title = 'Sign In';
const description = 'Sign in to your account to access personalized features, save favorites, and more.';
---

<Layout title={title} description={description}>
  <Container>
    <Sectionhead>
      <Fragment slot="title">{title}</Fragment>
      <Fragment slot="desc">{description}</Fragment>
    </Sectionhead>

    <div class="mx-auto max-w-lg">
      <div class="bg-white dark:bg-gray-900 py-8 px-6 shadow-lg rounded-lg border border-gray-200 dark:border-gray-700">
        <div class="mb-8">
          <h2 class="text-center text-3xl font-bold text-gray-900 dark:text-white">
            Welcome back
          </h2>
          <p class="mt-2 text-center text-sm text-gray-600 dark:text-gray-400">
            Sign in to access your account
          </p>
        </div>

        <LoginForm />
      </div>

      <!-- Additional Help -->
      <div class="mt-8 text-center">
        <div class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
          <p>
            <strong>Need help?</strong> Contact our 
            <a href="/contact" class="text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300 font-medium">
              support team
            </a>
          </p>
          <p>
            By signing in, you agree to our 
            <a href="/terms" class="text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300 font-medium">
              Terms of Service
            </a>
          </p>
        </div>
      </div>
    </div>
  </Container>
</Layout>

<style>
  /* Custom page styles */
  .container {
    @apply pt-12 pb-16;
  }

  /* Dark mode support */
  @media (prefers-color-scheme: dark) {
    body {
      color-scheme: dark;
    }
  }
</style>