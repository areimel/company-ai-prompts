---
import { Icon } from 'astro-icon/components';
import Button from '@components/ui/button.astro';
import NavLink from '@components/ui/NavLink.astro';

interface Props {
  user?: {
    id: string;
    email?: string;
    user_metadata?: {
      full_name?: string;
    };
  };
  profile?: {
    full_name?: string;
    display_name?: string;
    bio?: string;
  };
  favoritesCounts?: {
    prompts: number;
    personas: number;
    blog: number;
    total: number;
  };
  recentFavorites?: Array<{
    id: string;
    content_type: 'prompt' | 'persona' | 'blog';
    content_slug: string;
    content_title: string | null;
    created_at: string;
  }>;
  class?: string;
}

const {
  user,
  profile,
  favoritesCounts = { prompts: 0, personas: 0, blog: 0, total: 0 },
  recentFavorites = [],
  class: className,
} = Astro.props;

// Get display name from profile or user data
const displayName = profile?.display_name || profile?.full_name || user?.user_metadata?.full_name || user?.email?.split('@')[0] || 'User';

// Format date helper
const formatDate = (dateString: string) => {
  return new Date(dateString).toLocaleDateString('en-US', { 
    month: 'short', 
    day: 'numeric' 
  });
};

// Get content type display name
const getContentTypeDisplay = (type: string) => {
  switch (type) {
    case 'prompt': return 'Prompt';
    case 'persona': return 'AI Persona';
    case 'blog': return 'Blog Post';
    default: return type;
  }
};

// Get content URL
const getContentUrl = (type: string, slug: string) => {
  switch (type) {
    case 'prompt': return `/prompts/${slug}`;
    case 'persona': return `/ai-personas/${slug}`;
    case 'blog': return `/blog/${slug}`;
    default: return '#';
  }
};
---

<div class:list={["space-y-8", className]}>
  <!-- Welcome Section -->
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
          Welcome back, {displayName}!
        </h2>
        <p class="mt-1 text-gray-600 dark:text-gray-400">
          Here's what's been happening with your favorites
        </p>
      </div>
      <div class="hidden sm:block">
        <Icon name="boxicons:bx-heart" class="w-12 h-12 text-red-500" />
      </div>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <!-- Total Favorites -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-6">
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <Icon name="boxicons:bx-heart" class="w-8 h-8 text-red-500" />
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Total Favorites</p>
          <p class="text-2xl font-bold text-gray-900 dark:text-white">{favoritesCounts.total}</p>
        </div>
      </div>
    </div>

    <!-- Prompts -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-6">
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <Icon name="boxicons:bx-code-alt" class="w-8 h-8 text-blue-500" />
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Saved Prompts</p>
          <p class="text-2xl font-bold text-gray-900 dark:text-white">{favoritesCounts.prompts}</p>
        </div>
      </div>
    </div>

    <!-- AI Personas -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-6">
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <Icon name="boxicons:bx-user-circle" class="w-8 h-8 text-green-500" />
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-gray-600 dark:text-gray-400">AI Personas</p>
          <p class="text-2xl font-bold text-gray-900 dark:text-white">{favoritesCounts.personas}</p>
        </div>
      </div>
    </div>

    <!-- Blog Posts -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-6">
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <Icon name="boxicons:bx-book-reader" class="w-8 h-8 text-purple-500" />
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Blog Posts</p>
          <p class="text-2xl font-bold text-gray-900 dark:text-white">{favoritesCounts.blog}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Favorites and Quick Actions -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Recent Favorites -->
    <div class="lg:col-span-2">
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Recent Favorites</h3>
            <NavLink href="/favorites" class="text-sm text-indigo-600 hover:text-indigo-500 dark:text-indigo-400">
              View all →
            </NavLink>
          </div>
        </div>
        <div class="p-6">
          {recentFavorites.length > 0 ? (
            <div class="space-y-4">
              {recentFavorites.slice(0, 6).map((favorite) => (
                <div class="flex items-center justify-between py-3 border-b border-gray-100 dark:border-gray-700 last:border-0">
                  <div class="flex items-center space-x-3">
                    <div class="flex-shrink-0">
                      {favorite.content_type === 'prompt' && (
                        <Icon name="boxicons:bx-code-alt" class="w-5 h-5 text-blue-500" />
                      )}
                      {favorite.content_type === 'persona' && (
                        <Icon name="boxicons:bx-user-circle" class="w-5 h-5 text-green-500" />
                      )}
                      {favorite.content_type === 'blog' && (
                        <Icon name="boxicons:bx-book-reader" class="w-5 h-5 text-purple-500" />
                      )}
                    </div>
                    <div>
                      <NavLink 
                        href={getContentUrl(favorite.content_type, favorite.content_slug)}
                        class="text-sm font-medium text-gray-900 dark:text-white hover:text-indigo-600 dark:hover:text-indigo-400"
                      >
                        {favorite.content_title || favorite.content_slug}
                      </NavLink>
                      <p class="text-xs text-gray-500 dark:text-gray-400">
                        {getContentTypeDisplay(favorite.content_type)} • {formatDate(favorite.created_at)}
                      </p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="text-center py-8">
              <Icon name="boxicons:bx-heart" class="w-12 h-12 mx-auto text-gray-400 mb-4" />
              <h4 class="text-lg font-medium text-gray-900 dark:text-white mb-2">No favorites yet</h4>
              <p class="text-gray-600 dark:text-gray-400 mb-4">
                Start saving your favorite prompts, personas, and blog posts
              </p>
              <div class="space-x-3">
                <NavLink href="/prompts" class="text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 text-sm font-medium">
                  Browse Prompts
                </NavLink>
                <NavLink href="/ai-personas" class="text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 text-sm font-medium">
                  Explore Personas
                </NavLink>
              </div>
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="lg:col-span-1">
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Quick Actions</h3>
        </div>
        <div class="p-6 space-y-4">
          <NavLink 
            href="/favorites" 
            class="w-full bg-indigo-50 dark:bg-indigo-900/20 border border-indigo-200 dark:border-indigo-800 rounded-lg px-4 py-3 flex items-center space-x-3 hover:bg-indigo-100 dark:hover:bg-indigo-900/30 transition-colors"
          >
            <Icon name="boxicons:bx-heart" class="w-5 h-5 text-indigo-600 dark:text-indigo-400" />
            <span class="text-sm font-medium text-indigo-900 dark:text-indigo-100">View All Favorites</span>
          </NavLink>

          <NavLink 
            href="/profile" 
            class="w-full bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 rounded-lg px-4 py-3 flex items-center space-x-3 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
          >
            <Icon name="boxicons:bx-user" class="w-5 h-5 text-gray-600 dark:text-gray-400" />
            <span class="text-sm font-medium text-gray-900 dark:text-gray-100">Edit Profile</span>
          </NavLink>

          <NavLink 
            href="/prompts" 
            class="w-full bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 rounded-lg px-4 py-3 flex items-center space-x-3 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
          >
            <Icon name="boxicons:bx-search" class="w-5 h-5 text-gray-600 dark:text-gray-400" />
            <span class="text-sm font-medium text-gray-900 dark:text-gray-100">Browse Prompts</span>
          </NavLink>

          <NavLink 
            href="/ai-personas" 
            class="w-full bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 rounded-lg px-4 py-3 flex items-center space-x-3 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
          >
            <Icon name="boxicons:bx-user-circle" class="w-5 h-5 text-gray-600 dark:text-gray-400" />
            <span class="text-sm font-medium text-gray-900 dark:text-gray-100">AI Personas</span>
          </NavLink>

          <NavLink 
            href="/submit-prompt" 
            class="w-full bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg px-4 py-3 flex items-center space-x-3 hover:bg-green-100 dark:hover:bg-green-900/30 transition-colors"
          >
            <Icon name="boxicons:bx-plus" class="w-5 h-5 text-green-600 dark:text-green-400" />
            <span class="text-sm font-medium text-green-900 dark:text-green-100">Submit Prompt</span>
          </NavLink>
        </div>
      </div>
    </div>
  </div>
</div>